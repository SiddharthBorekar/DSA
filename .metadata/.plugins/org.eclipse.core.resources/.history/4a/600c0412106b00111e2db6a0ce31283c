public class Swap_alternate_element {
	public static void main(String[] args) {
		int arr[] = {4,5,6,1,5,8};
		
		for(int i=0;i<arr.length;i++) {
			int x = arr[i];
			int y = arr[i+1];
			
			int temp = 0;
			
			temp = x;
			x = y;
			y = temp;
			
			System.out.println(arr[i]);
			
		}
		
	}
}






	
















